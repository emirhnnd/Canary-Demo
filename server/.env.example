# Copy this file to .env and fill in your key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional
PORT=8787
GEMINI_MODEL=gemini-2.5-flash

# 1 = skip real work and replay the scripted scenario (stage safety net)
DEMO_SCRIPTED=0

# Security: appUrl may point at localhost/private IPs only when this is 1 (local demos).
# Leave it 0/unset on any server reachable from the internet.
ALLOW_LOCAL_TARGETS=0

# Bind address (default 127.0.0.1 = this machine only).
# HOST=127.0.0.1
