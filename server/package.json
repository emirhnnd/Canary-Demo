{
  "name": "canary-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Canary demo backend: clones a repo, infers user flows with Gemini, runs Playwright tests, traces failures to source.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:scripted": "cross-env DEMO_SCRIPTED=1 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:scripted": "cross-env DEMO_SCRIPTED=1 tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "playwright": "^1.48.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
